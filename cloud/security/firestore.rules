rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isOperatorOrAbove() {
      return hasRole('operator') || hasRole('supervisor') || hasRole('admin');
    }

    function isSupervisorOrAdmin() {
      return hasRole('supervisor') || hasRole('admin');
    }

    match /publicDashboard/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /incidents/{incidentId} {
      allow read: if isSignedIn();
      allow create, update: if isOperatorOrAbove();
      allow delete: if isSupervisorOrAdmin();
    }

    match /operatorActions/{actionId} {
      allow read: if isSignedIn();
      allow create: if isOperatorOrAbove();
      allow update, delete: if isSupervisorOrAdmin();
    }

    match /securityEvents/{eventId} {
      allow read: if hasRole('admin');
      allow write: if false;
    }
  }
}
