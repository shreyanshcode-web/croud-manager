# SV-Companion — Environment Variables Reference
# Copy this file to .env and fill in your actual values for local dev.
# In production (Cloud Run), set these via the GCP Console or Secret Manager.

# ── Google Identity Services ──────────────────────────────────── (Google Service)
VITE_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret

# ── Gemini AI ─────────────────────────────────────────────────── (Google Service)
GEMINI_API_KEY=your-gemini-api-key

# ── Google Maps Platform ──────────────────────────────────────── (Google Service)
# Needs: Maps JavaScript API, Maps Embed API, Directions API, Places API (Nearby Search)
GOOGLE_MAPS_API_KEY=your-maps-api-key
VITE_GOOGLE_MAPS_API_KEY=your-maps-api-key   # exposed to frontend for embedding

# ── Google Cloud Translation API ─────────────────────────────── (Google Service)
GOOGLE_TRANSLATE_API_KEY=your-translate-api-key

# ── Google Cloud Text-to-Speech API ──────────────────────────── (Google Service)
# Enables "Read Aloud" on AI responses in 11 languages (WaveNet voices)
GOOGLE_TTS_API_KEY=your-tts-api-key

# ── Google Analytics 4 ───────────────────────────────────────── (Google Service)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX          # e.g. G-ABCDEF1234

# ── Firebase / Google Cloud Firestore ────────────────────────── (Google Service)
# In Cloud Run, ADC (Application Default Credentials) picks this up automatically.
# Locally, set GOOGLE_APPLICATION_CREDENTIALS to your service account key file.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json  (local only)
# FIRESTORE_EMULATOR_HOST=localhost:8080                         (emulator only)

# ── Google Cloud Pub/Sub / Kafka ─────────────────────────────── (optional)
KAFKA_BROKERS=broker1:9092,broker2:9092
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL=true

# ── Redis (rate limiting + caching) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── Application ─────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
