# Google Cloud
GOOGLE_CLOUD_PROJECT=nth-bounty-477010-h8
VITE_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# Redis (local dev default — docker-compose.dev.yml)
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=          # set for production Redis

# Kafka (local dev default — docker-compose.dev.yml)
KAFKA_BROKERS=localhost:9092
# For Confluent Cloud:
# KAFKA_BROKERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
# KAFKA_USERNAME=your-api-key
# KAFKA_PASSWORD=your-api-secret
# KAFKA_SSL=true

# Gemini (fetched from Secret Manager in prod; set locally for dev)
# GEMINI_API_KEY=your-key
